# Paths on the Docker daemon host. Set these before executing.
# Use a dedicated tiny-run output directory, separate from the corpus.
CORPUS_ROOT=./data/corpus
EXPERIMENT_DATA_ROOT=./data/smoke
RUNS_ROOT=./runs
CACHE_ROOT=./.cache/benchmark
# Optional image provenance, required for full training (not used by this smoke).
S2ST_DOCKER_IMAGE_DIGEST=
